# The Dockerfile copies named files and whole directories, so anything left in
# catalog/, discstakka/, static/ or tools/ ships unless it is excluded here.

# -- Never belongs in an image --------------------------------------------
.git
.github
.gitignore
.dockerignore
Dockerfile
docker-compose.yml

# The venvs hold macOS-specific binaries, including a darwin build of hid.so.
.venv
.venv-*
venv
env
.direnv

__pycache__
**/__pycache__
*.py[cod]
*.egg-info

.pytest_cache
.mypy_cache
.ruff_cache
.tox
.coverage
htmlcov
requirements-nohid.txt

# nix build symlinks, from flake.nix
result
result-*

.DS_Store
._*
.idea
.vscode
*.swp
*~

# -- Arrives as a bind mount, never as an image layer ----------------------
# docker-compose.yml mounts both. Baking them in would shadow the mount on
# first boot and ship the user's catalogue and cover art inside the image.
data
static/art

# -- Host-side only --------------------------------------------------------
deploy
flake.nix
*.md

# -- Development tools -----------------------------------------------------
# The suite does not ship. tools/fakerun.py does, and works there now: the
# simulated carousel it drives is part of the package.
tests
