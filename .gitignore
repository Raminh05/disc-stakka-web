# -- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments. These hold platform-specific binaries, including a
# darwin build of hid.so, so one is never portable to another machine.
.venv/
.venv-*/
venv/
env/
.direnv/

# Generated by the no-hidapi CI job; harmless, but not part of the project.
requirements-nohid.txt

# -- Tooling --------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# nix build symlinks, from flake.nix
result
result-*

# -- Editors and operating systems ----------------------------------------
.DS_Store
._*
.idea/
.vscode/
*.swp
*~

# -- This project's own state ---------------------------------------------
# The live catalogue, the session key and the device traces: the user's real
# data, not the project's. The suite needs none of it - the one trace the
# calibration test reads is committed separately under tests/fixtures/.
/data/

# Cover art arrives as a bind mount, never as a repo file.
/static/art/

# schema.sql sets journal_mode = WAL, so every database grows these two
# sidecars next to it. A test or scratch database outside data/ would leave
# them lying around.
*.db-wal
*.db-shm
